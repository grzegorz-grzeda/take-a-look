# Copy to .env on the VPS and fill in. .env is git-ignored: never commit it.

# Public hostname of this service (TLS is terminated by the edge project's Caddy).
DOMAIN=

# Meta app (guide 4). All secret except the version.
# App Dashboard -> App settings -> Basic -> App secret
META_APP_SECRET=
# Any long random string you choose; the same value goes into the dashboard's "Verify token" field.
# Generate: openssl rand -hex 32
META_VERIFY_TOKEN=
# Page access token generated in the Messenger API settings for the Page.
# May stay empty at first: the webhook then logs payloads but sends no replies.
META_PAGE_ACCESS_TOKEN=
# Graph API version used for the Send API, e.g. v26.0
META_GRAPH_API_VERSION=
