# Caddy obtains and renews the certificate for {$DOMAIN} automatically (Let's Encrypt / ZeroSSL).
# Guides: docs/guides/03-compose-and-caddy.md, docs/guides/04-meta-app-and-webhook.md

{$DOMAIN} {
	encode zstd gzip

	handle /health {
		respond "ok" 200
	}

	handle /webhook {
		request_body {
			max_size 1MB
		}
		reverse_proxy webhook:8000
	}

	handle {
		respond "Not found" 404
	}
}
